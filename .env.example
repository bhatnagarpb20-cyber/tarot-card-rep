# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (accounts, journal sync) ---------------------------------------
# Public values: safe in the browser because row-level security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Used solely to delete auth accounts on request. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL, used in password-reset and confirmation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI interpretations (optional) -------------------------------------------
# SERVER ONLY. Without it the app uses reference readings from the card library.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
# Set to "none" to force AI off even if a key is present.
AI_PROVIDER=
# Allow guests (not signed in) to request AI readings. Off by default.
ALLOW_GUEST_AI=false
GUEST_AI_DAILY_LIMIT=3
# Signed-in users' daily AI limit lives in the database (private.settings), default 20.

# --- Tests -------------------------------------------------------------------
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
